# ============================================
# Power BI MCP Agent — Environment Variables
# ============================================

# LLM Provider: "gemini", "openai", or "anthropic"
LLM_PROVIDER=gemini

# LLM Model name
LLM_MODEL=gemini-3.7-flash

# API Keys (set the one matching your LLM_PROVIDER)
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Read-only BigQuery integration and local Power BI semantic-model bridge
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\your-user\.credentials\bigquery-agent.json
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_LOCATION=EU
BIGQUERY_ALLOWED_DATASETS=your-project-id.your_dataset
BIGQUERY_MAX_BYTES_BILLED=1000000000
# Row cap for embedded cloud snapshots and local queries. Max 10000.
BIGQUERY_MAX_ROWS=10000
# Power BI BigQuery connector: ADBC 2.0 is the forward-compatible default.
BIGQUERY_POWERBI_IMPLEMENTATION=2.0
# Keep false unless the identity also has BigQuery Storage API permissions.
BIGQUERY_POWERBI_USE_STORAGE_API=false
# Set true only when local Google API traffic must bypass a broken/system proxy.
BIGQUERY_BYPASS_PROXY=false

# Transport mode: "STDIO" for local Power BI Desktop, "SSE" for Fabric remote
POWERBI_TRANSPORT_MODE=STDIO

# SSE-specific (only needed if POWERBI_TRANSPORT_MODE=SSE)
POWERBI_SSE_URL=https://api.fabric.microsoft.com/v1/mcp/powerbi
FABRIC_ACCESS_TOKEN=eyJ-your-token-here

# STDIO-specific (usually leave defaults)
POWERBI_STDIO_COMMAND=npx

# Root directory the PBIR authoring tools may inspect and stage within
POWERBI_AUTHORING_ROOT=.

# Cloud report workspace. Use "pro" for a Power BI Pro workspace; use
# "capacity" only for Fabric/Premium/Embedded workspaces that support ExportToFile.
POWERBI_CLOUD_LICENSE_MODE=pro
POWERBI_STAGING_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Recommended unattended authentication: Microsoft Entra app registration.
# Grant the app access to the staging workspace and enable the tenant settings
# that allow service principals to use Fabric and Power BI APIs.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# Optional short-lived token overrides for interactive testing. These are
# separate because Fabric and Power BI REST APIs use different audiences.
FABRIC_API_ACCESS_TOKEN=
POWERBI_API_ACCESS_TOKEN=

# Cloud polling and multimodal screenshot review
POWERBI_CLOUD_TIMEOUT_SECONDS=600
POWERBI_CLOUD_POLL_SECONDS=3

# Durable single-user autonomous qualification state and artifacts
POWERBI_QUALIFICATION_ROOT=.dashboard-workspaces/qualification
POWERBI_QUALIFICATION_STATE_PATH=.dashboard-workspaces/qualification/qualification.sqlite3

POWERBI_VISION_PROVIDER=gemini
POWERBI_VISION_MODEL=gemini-3.7-flash

# Runtime dashboard QA admission policy
POWERBI_QA_MAX_ATTEMPTS=3
POWERBI_QA_REQUIRE_SEMANTIC_CATALOG=false
POWERBI_QA_VALIDATE_OFFICIAL_SCHEMAS=true
POWERBI_QA_ALLOW_SCHEMA_DOWNLOAD=false
# Comma-separated quality codes to promote from improvement to blocking.
POWERBI_QA_BLOCKING_QUALITY_CODES=
# Durable LangGraph state. Use Redis 8 / Redis Stack locally.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_CHECKPOINT_TTL_MINUTES=1440
AGENT_MAX_CONTEXT_MESSAGES=80
AGENT_MAX_TOOL_RESULT_CHARS=50000
AGENT_TOOL_TIMEOUT_SECONDS=120
